{"file":"laboratorio-DbR-y1py.js","mappings":";;;;;;;;;;;;;;;;;;;AAIA,UAAM,aAAa,CAAC,SAAS,GAAG,IAAI,IAAIA,iBAAU,IAAI,CAAC,MAAM,EAAE,SAAS,CAAC,CAAC;AAC1E,UAAM,WAAW;AAAA,MACf,EAAE,MAAM,KAAK,QAAQ,KAAA;AAAA,MACrB,EAAE,MAAM,KAAK,QAAQ,EAAA;AAAA,MACrB,EAAE,MAAM,KAAK,QAAQ,KAAA;AAAA,IAAK;AAE5B,UAAM,OAAO,CAAC,UAAU,SAAS,SAAS;AAE1C,UAAM,YAAY,IAAI,OAAO;AAC7B,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,cAAc,IAAIA,iBAAU,CAAC,CAAC;AACpC,UAAM,SAAS,IAAI,CAAC;AACpB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,UAAU,IAAI,CAAC;AACrB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,MAAM,IAAI,CAAC;AACD,QAAI,IAAI;AAUxB,UAAM,WAAW,SAAS,MAAM;AAC9B,YAAM,QAAQ,MAAM,MAAM,KAAA,EAAO,YAAA;AACjC,aAAOA,iBAAU;AAAA,QACf,CAAC,OACE,UAAU,UAAU,WAAW,EAAE,cAAc,UAAU,UAC1D,EAAE,KAAK,YAAA,EAAc,SAAS,KAAK;AAAA,MAAA;AAAA,IAEzC,CAAC;;;QAIM,OAAM;AAAA,QAAK,cAAW;AAAA,QAAsC,MAAK;AAAA,MAAA,kFAIvDC,MAAA,KAAA,CAAK;AAUGC,oBAAA,aAAR,SAAI;sCAEV,gBAAcD,MAAA,SAAA,MAAc,IAAI,oBAG9B,IAAI;;;AAMYC,oBAAAD,MAAA,QAAA,IAAZ,aAAQ;AAGd,cAAA,0BAAAE,cAAA,gBAAcF,MAAA,WAAA,EAAY,OAAO,SAAS,EAAE,CAAA,yDAAA;AAKpBC,sBAAA,SAAS,QAAM,CAA5B,OAAO,MAAC;qDAEF,KAAK,EAAA,CAAA,WAAA;AAAA;AAGpB,cAAA,mBAAAE,eAAA,SAAS,IAAI,CAAA,WAAA;AAAA;;AAER,UAAA,CAAAH,MAAA,QAAA,EAAS,QAAM;;;;;8DAGgB,cAAYA,MAAA,WAAA,EAAY,IAAI,SAC9DG,eAAAH,MAAA,WAAA,EAAY,IAAI;uBAGgBA,MAAA,MAAA;AAAA,qBAAiCA,MAAA,OAAA,IAAO,QAAA;AAAA,MAAA;AAMrE,UAAAA,MAAA,WAAA,EAAY,OAAE,WAAgBA,MAAA,WAAA,EAAY,OAAE,YAAA;gCAEnBI,eAAA,CAAA,EAAA,qBAAAJ,MAAA,WAAA,EAAY,OAAE,WAAA,GAAA,UAAA,CAAA,MAG1CG,eAAAH,MAAA,OAAA,eAAqBA,MAAA,OAAA,CAAO,MAAA,aAAA;MAGpB,WAAAA,MAAA,WAAA,EAAY,OAAE,YAAiBA,MAAA,WAAA,EAAY,OAAE,UAAA;;AAG5C,YAAAA,MAAA,WAAA,EAAY,OAAE,UAAA;;;;;;MAKV,WAAAA,MAAA,WAAA,EAAY,OAAE,SAAA;gFAEdA,MAAA,KAAA,CAAK,CAAA,iDAAA;AAAA,MAEL,WAAAA,MAAA,WAAA,EAAY,OAAE,WAAA;qFACdA,MAAA,OAAA,CAAO,oBAAPA,MAAA,OAAA,GAAO,IAAA,IAAPA,MAAA,OAAA,CAAO,IAAA,aAAA,sCACpBA,MAAA,OAAA,IAAO,YAAA,aAAA;;AAEqC,cAAA,eAAAI,eAAA,CAAA,EAAA,WAAAJ,MAAA,WAAA,EAAY,OAAE,OAAA,GAAA,SAAA,CAAA,CAAA,iBAAA;sBAGrC,MAAI,CAAhB,MAAM,MAAC;wCAEd,gBAAcA,MAAA,GAAA,MAAQ,CAAC,oBAGrB,IAAI;;;AAGF,YAAAA,MAAA,WAAA,EAAY,OAAE,QAAA;AAA0B,gBAAA,gBAAAG,eAAA,KAAKH,MAAA,GAAA,CAAG,CAAA,CAAA,MAAA;AAAA;;;;;;AAQxCC,oBAAA,WAAR,SAAI;wBAEVC,cAAA,gBAAcF,MAAA,MAAA,MAAW,KAAK,MAAM,KAGlCG,eAAA,KAAK,IAAI;;8EAIEH,MAAA,OAAA,CAAO,oBAAPA,MAAA,OAAA,GAAO,IAAA,IAAPA,MAAA,OAAA,CAAO,IAAA,aAAA,EAAA,wEAAA;AAAA;;;;;;;;;AC/InC,MAAM,YACJ;;;;;AACF,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aAAa;AAAA,MACb,SAAS;AAAA,MACT,eAAe;AAAA,IAAA,CAChB;AAED,UAAM,cAAc,SAAS,OAAO,CAAC,MAAM,EAAE,WAAW,aAAa;AACrE,UAAM,eAAe,SAAS,OAAO,CAAC,MAAM,EAAE,WAAW,YAAY;AAErE,UAAM,OAAO,IAAI,KAAK;AACtB,UAAM,SAAS,IAAI,IAAI;AACvB,UAAM,kBAAkB,IAAI,KAAK;AACjC,UAAM,kBAAkB,IAAI,KAAK;AAEjC,aAAS,SAAS,IAAI;AACpB,MAAA,SAAS,eAAe,EAAE,GAAG,eAAe;AAAA,QAC1C,UAAU,OAAO,QAAQ,WAAW;AAAA,QACpC,OAAO;AAAA,MAAA,CACR;AAAA,IACH;AAyBA,QAAI;AAEJ,aAAS,mBAAmB;AAC1B,UAAI,CAAC,OAAO,SAAS,KAAgB;AAAA,IAkBvC;AACA,aAAS,iBAAiB;AACxB,gBAAU,OAAA;AACV,iBAAW;AAAA,IACb;AAEA,UAAM,QAAQ,YAAY;AACxB,qBAAA;AACA,YAAM,SAAA;AACN,uBAAA;AAAA,IACF,CAAC;;;;;;QAuBG,OAAK,CAAC,oBAAkB,EAAA,QACNA,MAAA,IAAA,4BAA+BA,MAAA,MAAA,GAAM;AAAA,MAAA,sGAMnCI,eAAA,CAAA,EAAA,QAAAJ,MAAA,eAAA,WAAyBA,MAAA,eAAA,EAAA,GAAe,WAAA,CAAA;;QAEhD,OAAM;AAAA,QAAQ,IAAG;AAAA,QAAI,cAAW;AAAA,MAAA;yBAA1C,CAEC,GAAAK,QAAAC,UAAA,aAAA;;;;;8BADE,QAAM;AAAA,cAAAC,YAAQ,WAAL,GAAC;AAAA,YAAA;AAAA;;;;;;QAOH,OAAM;AAAA,QAAW,IAAG;AAAA,MAAA;yBAA9B,CAAsD,GAAAF,QAAAC,UAAA,aAAA;;;;;8BAApB,WAAS;AAAA,YAAA;AAAA;;;;4RAaHH,eAAAH,MAAA,WAAA,EAAY,MAAM,oEAI9CG,eAAAH,MAAA,YAAA,EAAa,MAAM;;QAK1B,QAAQA,MAAA,QAAA;AAAA,QACR,WAAWA,MAAA,MAAA;AAAA,QACZ,YAAA;AAAA,QACC,YAAU;AAAA,MAAA;;AAaSC,oBAAAD,MAAA,WAAA,IAAX,YAAO;kCACb,MAAI,QAAQ,EAAE,qCAGIQ,eAAA,EAAA,SAAA,QAAQ,IAAA,CAAG,UAEvBL,eAAA,QAAQ,IAAI,iBAEXA,eAAA,QAAQ,MAAM,4CACI,QAAQ,YAAY,KAAI,IAAA,CAAA;AAExC,YAAA,QAAQ,MAAI;;YAClB,OAAM;AAAA,YACL,IAAI,QAAQ;AAAA,UAAA;6BAHf,CAKC,GAAAE,QAAAC,UAAA,aAAA;;AADKD,uBAAA,GAAAF,eAAA,QAAQ,MAAM,CAAA,EAAA;AAAA;;kBAAdM,gBAAAC,gBAAA,QAAQ,MAAM,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;;;;;;;AAgBJT,oBAAAD,MAAA,YAAA,IAAX,YAAO;uCACb,MAAI,QAAQ,EAAE,kCAIRG,eAAA,QAAQ,IAAI,YACbA,eAAA,QAAQ,MAAM;sBAKK,QAAQ,OAAK,CAArB,SAAI;sCAAkC,IAAI,CAAA,OAAA;AAAA;;sBAMlC,QAAQ,OAAK,CAArB,SAAI;sCAAkC,IAAI,CAAA,OAAA;AAAA;8EAInC,QAAQ,YAAY,KAAI,IAAA,CAAA,CAAA,gBAAA;AAAA;;AAa/B,YAAAQ,mBAAA,gCAAA,EAAA,OAAM,aAAS,MAAA,OAAA,CAAA;;;QAMxB,OAAM;AAAA,QAAc,IAAG;AAAA,MAAA;yBAAjC,CAA+D,GAAAN,QAAAC,UAAA,aAAA;;;;;8BAA1B,iBAAe;AAAA,YAAA;AAAA;;;;sDAGrCH,gBAAA,oBAAA,KAAA,GAAO,aAAW,mDAEDD,cAAA,gBAAcF,MAAA,IAAA,CAAI,oBAC3CA,MAAA,IAAA,IAAI,eAAA,aAAA,oBAE0BE,cAAA,iBAAeF,MAAA,MAAA,CAAM,oBACnDA,MAAA,MAAA,IAAM,uBAAA,iBAAA;AAED,YAAAW,mBAAA,qBAAA,EAAA,IAAG,eAAW;AAAA,yBAAxB,CAA2C,GAAAN,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["elementos","_unref","_ssrRenderList","_ssrRenderAttr","_ssrInterpolate","_ssrRenderClass","_push","_parent","_createVNode","_ssrRenderStyle","_createTextVNode","_toDisplayString","_ssrRenderComponent"],"sources":["../../../../components/BibliotecaWireframe.vue","../../../../pages/laboratorio.vue"],"sourcesContent":["<script setup>\n// Rascunho da página da biblioteca. Os elementos são de exemplo, até ligar com a biblioteca real.\nimport { elementosExemplo as elementos } from \"~/data/laboratorio\";\n\nconst categorias = [\"Todos\", ...new Set(elementos.map((e) => e.categoria))];\nconst tamanhos = [\n  { nome: \"P\", escala: 0.85 },\n  { nome: \"M\", escala: 1 },\n  { nome: \"G\", escala: 1.25 },\n];\nconst abas = [\"Início\", \"Sobre\", \"Contato\"];\n\nconst categoria = ref(\"Todos\");\nconst busca = ref(\"\");\nconst selecionado = ref(elementos[0]);\nconst escala = ref(1);\nconst redondo = ref(false);\nconst cliques = ref(0);\nconst texto = ref(\"\");\nconst marcado = ref(false);\nconst aba = ref(0);\nconst detalhe = ref(null);\n\n// Em telas estreitas a prévia fica abaixo da lista, fora da vista.\nfunction escolher(elemento) {\n  selecionado.value = elemento;\n  if (window.matchMedia(\"(max-width: 1000px)\").matches) {\n    detalhe.value.scrollIntoView({ behavior: \"instant\", block: \"nearest\" });\n  }\n}\n\nconst visiveis = computed(() => {\n  const termo = busca.value.trim().toLowerCase();\n  return elementos.filter(\n    (e) =>\n      (categoria.value === \"Todos\" || e.categoria === categoria.value) &&\n      e.nome.toLowerCase().includes(termo),\n  );\n});\n</script>\n\n<template>\n  <div class=\"wf\" aria-label=\"Rascunho da biblioteca de elementos\" role=\"group\">\n    <div class=\"wf-topo\">\n      <b>Biblioteca</b>\n      <input\n        v-model=\"busca\"\n        type=\"search\"\n        placeholder=\"Buscar elemento\"\n        aria-label=\"Buscar elemento\"\n      />\n    </div>\n\n    <div class=\"wf-corpo\">\n      <nav class=\"wf-categorias\" aria-label=\"Categorias\">\n        <button\n          v-for=\"item in categorias\"\n          :key=\"item\"\n          :aria-pressed=\"categoria === item\"\n          @click=\"categoria = item\"\n        >\n          {{ item }}\n        </button>\n      </nav>\n\n      <div class=\"wf-grade\">\n        <button\n          v-for=\"elemento in visiveis\"\n          :key=\"elemento.id\"\n          class=\"wf-item\"\n          :aria-pressed=\"selecionado.id === elemento.id\"\n          @click=\"escolher(elemento)\"\n        >\n          <span class=\"wf-miniatura\" aria-hidden=\"true\">\n            <span\n              v-for=\"(forma, i) in elemento.formas\"\n              :key=\"i\"\n              :class=\"`wf-${forma}`\"\n            ></span>\n          </span>\n          {{ elemento.nome }}\n        </button>\n        <p v-if=\"!visiveis.length\" class=\"wf-vazio\">Nada encontrado.</p>\n      </div>\n\n      <section ref=\"detalhe\" class=\"wf-detalhe\" :aria-label=\"selecionado.nome\">\n        <h3>{{ selecionado.nome }}</h3>\n        <div\n          class=\"wf-palco\"\n          :style=\"{\n            '--wf-escala': escala,\n            '--wf-raio': redondo ? '1em' : '0px',\n          }\"\n        >\n          <button\n            v-if=\"selecionado.id === 'botao' || selecionado.id === 'contorno'\"\n            class=\"wf-botao\"\n            :class=\"{ 'wf-botao-contorno': selecionado.id === 'contorno' }\"\n            @click=\"cliques++\"\n          >\n            {{ cliques ? `Clicado ${cliques}x` : \"Clique aqui\" }}\n          </button>\n          <div\n            v-else-if=\"selecionado.id === 'cartao' || selecionado.id === 'imagem'\"\n            class=\"wf-cartao\"\n          >\n            <span v-if=\"selecionado.id === 'imagem'\" class=\"wf-foto\"></span>\n            <b>Título</b>\n            <span class=\"wf-linha\"></span>\n            <span class=\"wf-linha wf-curta\"></span>\n          </div>\n          <label v-else-if=\"selecionado.id === 'campo'\" class=\"wf-campo\">\n            Seu nome\n            <input v-model=\"texto\" type=\"text\" placeholder=\"Digite aqui\" />\n          </label>\n          <label v-else-if=\"selecionado.id === 'selecao'\" class=\"wf-selecao\">\n            <input v-model=\"marcado\" type=\"checkbox\" />\n            {{ marcado ? \"Marcado\" : \"Marque aqui\" }}\n          </label>\n          <div v-else class=\"wf-abas\" :class=\"{ 'wf-menu': selecionado.id === 'menu' }\">\n            <div>\n              <button\n                v-for=\"(item, i) in abas\"\n                :key=\"item\"\n                :aria-pressed=\"aba === i\"\n                @click=\"aba = i\"\n              >\n                {{ item }}\n              </button>\n            </div>\n            <p v-if=\"selecionado.id === 'abas'\">Conteúdo: {{ abas[aba] }}</p>\n          </div>\n        </div>\n\n        <div class=\"wf-controles\">\n          <div role=\"group\" aria-label=\"Tamanho\">\n            <span>Tamanho</span>\n            <button\n              v-for=\"item in tamanhos\"\n              :key=\"item.nome\"\n              :aria-pressed=\"escala === item.escala\"\n              @click=\"escala = item.escala\"\n            >\n              {{ item.nome }}\n            </button>\n          </div>\n          <label>\n            <input v-model=\"redondo\" type=\"checkbox\" />\n            Cantos redondos\n          </label>\n        </div>\n      </section>\n    </div>\n  </div>\n</template>\n","<script setup>\nimport { gsap } from \"gsap\";\nimport { projetos } from \"~/data/laboratorio\";\n\nconst descricao =\n  \"Projetos pessoais de Victor, desenvolvedor web: os que já funcionam e os que ainda estão em construção.\";\nuseSeoMeta({\n  title: \"Laboratório do Victor\",\n  description: descricao,\n  ogTitle: \"Laboratório do Victor\",\n  ogDescription: descricao,\n});\n\nconst funcionando = projetos.filter((p) => p.estado === \"funcionando\");\nconst emConstrucao = projetos.filter((p) => p.estado === \"construcao\");\n\nconst dark = ref(false);\nconst motion = ref(true);\nconst cabecalhoSolido = ref(false);\nconst cabecalhoOculto = ref(false);\n\nfunction rolarAte(id) {\n  document.getElementById(id)?.scrollIntoView({\n    behavior: motion.value ? \"smooth\" : \"instant\",\n    block: \"center\",\n  });\n}\nfunction navegar(evento) {\n  const link = evento.target.closest('a[href^=\"#\"]');\n  if (!link) return;\n  const destino = document.getElementById(link.getAttribute(\"href\").slice(1));\n  if (!destino) return;\n  evento.preventDefault();\n  destino.scrollIntoView({ behavior: motion.value ? \"smooth\" : \"instant\" });\n}\nfunction toggleTheme() {\n  dark.value = !dark.value;\n  try {\n    localStorage.setItem(\"victor-theme\", dark.value ? \"dark\" : \"light\");\n  } catch {}\n}\nlet ultimaRolagem = 0;\nfunction acompanharCabecalho() {\n  const atual = window.scrollY;\n  const abertura = document.querySelector(\".lab-abertura\");\n  cabecalhoSolido.value = atual > abertura.offsetHeight - 90;\n  if (Math.abs(atual - ultimaRolagem) < 6) return;\n  cabecalhoOculto.value = atual > ultimaRolagem && atual > 200;\n  ultimaRolagem = atual;\n}\n\nlet contexto;\nlet ScrollTrigger;\nfunction iniciarAnimacoes() {\n  if (!motion.value || !ScrollTrigger) return;\n  contexto = gsap.context(() => {\n    gsap.from(\".lab-abertura .bloco-corpo\", {\n      z: 120,\n      duration: 0.9,\n      ease: \"bounce.out\",\n      stagger: 0.09,\n    });\n    gsap.utils.toArray(\".revelar\").forEach((elemento) => {\n      gsap.from(elemento, {\n        y: 40,\n        opacity: 0,\n        duration: 0.9,\n        ease: \"power3.out\",\n        scrollTrigger: { trigger: elemento, start: \"top 90%\", once: true },\n      });\n    });\n  });\n}\nfunction pararAnimacoes() {\n  contexto?.revert();\n  contexto = null;\n}\n\nwatch(motion, async () => {\n  pararAnimacoes();\n  await nextTick();\n  iniciarAnimacoes();\n});\n\nonMounted(async () => {\n  try {\n    dark.value = localStorage.getItem(\"victor-theme\") === \"dark\";\n  } catch {}\n  motion.value = !window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  window.addEventListener(\"scroll\", acompanharCabecalho, { passive: true });\n  window.addEventListener(\"resize\", acompanharCabecalho, { passive: true });\n  acompanharCabecalho();\n  ({ ScrollTrigger } = await import(\"gsap/ScrollTrigger\"));\n  gsap.registerPlugin(ScrollTrigger);\n  iniciarAnimacoes();\n});\nonBeforeUnmount(() => {\n  window.removeEventListener(\"scroll\", acompanharCabecalho);\n  window.removeEventListener(\"resize\", acompanharCabecalho);\n  pararAnimacoes();\n});\n</script>\n\n<template>\n  <div\n    class=\"site laboratorio\"\n    :class=\"{ escuro: dark, 'movimento-desativado': !motion }\"\n    @click=\"navegar\"\n  >\n    <a class=\"pular-conteudo\" href=\"#funcionando\">Pular para os projetos</a>\n    <header\n      class=\"cabecalho\"\n      :class=\"{ solido: cabecalhoSolido, oculto: cabecalhoOculto }\"\n    >\n      <NuxtLink class=\"marca\" to=\"/\" aria-label=\"Victor, portfólio\"\n        >victor<i>.</i></NuxtLink\n      >\n      <nav class=\"navegacao-principal\" aria-label=\"Seções do laboratório\">\n        <a href=\"#funcionando\">Já funcionam</a>\n        <a href=\"#construcao\">Em construção</a>\n        <a href=\"#experimentar\">Biblioteca</a>\n      </nav>\n      <NuxtLink class=\"link-lab\" to=\"/\">Portfólio</NuxtLink>\n    </header>\n\n    <main id=\"conteudo\">\n      <section class=\"lab-abertura\">\n        <div class=\"lab-abertura-texto\">\n          <h1>Laboratório</h1>\n          <p>\n            O que faço por conta própria: projetos que já funcionam e outros que\n            ainda estão na bancada.\n          </p>\n          <ul class=\"lab-legenda\">\n            <li>\n              <span class=\"amostra\"></span>{{ funcionando.length }} funcionando\n            </li>\n            <li>\n              <span class=\"amostra amostra-obra\"></span\n              >{{ emConstrucao.length }} em construção\n            </li>\n          </ul>\n        </div>\n        <Bancada\n          :blocos=\"projetos\"\n          :movimento=\"motion\"\n          interativa\n          @escolher=\"rolarAte\"\n        />\n      </section>\n\n      <section id=\"funcionando\" class=\"secao\">\n        <div class=\"cabecalho-secao\">\n          <h2 class=\"revelar\">Já <u>funcionam</u></h2>\n          <p class=\"revelar\">\n            Estes já dá para usar.\n          </p>\n        </div>\n        <ul class=\"lab-lista\">\n          <li\n            v-for=\"projeto in funcionando\"\n            :id=\"projeto.id\"\n            :key=\"projeto.id\"\n            class=\"lab-item revelar\"\n            :style=\"{ '--cor': projeto.cor }\"\n          >\n            <h3>{{ projeto.nome }}</h3>\n            <div>\n              <p>{{ projeto.resumo }}</p>\n              <p class=\"lab-pilha\">{{ projeto.tecnologias.join(\", \") }}</p>\n              <NuxtLink\n                v-if=\"projeto.rota\"\n                class=\"link-texto\"\n                :to=\"projeto.rota\"\n                >{{ projeto.rotulo }}</NuxtLink\n              >\n            </div>\n          </li>\n        </ul>\n      </section>\n\n      <section id=\"construcao\" class=\"lab-construcao secao\">\n        <div class=\"cabecalho-secao\">\n          <h2 class=\"revelar\">Na <u>bancada</u></h2>\n          <p class=\"revelar\">\n            Ainda não estão prontos. Aqui fica o que já existe e o que falta.\n          </p>\n        </div>\n        <div class=\"lab-obras\">\n          <article\n            v-for=\"projeto in emConstrucao\"\n            :id=\"projeto.id\"\n            :key=\"projeto.id\"\n            class=\"lab-obra revelar\"\n          >\n            <h3>{{ projeto.nome }}</h3>\n            <p>{{ projeto.resumo }}</p>\n            <div class=\"lab-andamento\">\n              <div>\n                <h4>Já tem</h4>\n                <ul>\n                  <li v-for=\"item in projeto.feito\" :key=\"item\">{{ item }}</li>\n                </ul>\n              </div>\n              <div>\n                <h4>Falta</h4>\n                <ul>\n                  <li v-for=\"item in projeto.falta\" :key=\"item\">{{ item }}</li>\n                </ul>\n              </div>\n            </div>\n            <p class=\"lab-pilha\">{{ projeto.tecnologias.join(\", \") }}</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"experimentar\" class=\"secao\">\n        <div class=\"cabecalho-secao\">\n          <h2 class=\"revelar\">Mexa na <u>biblioteca</u></h2>\n          <p class=\"revelar\">\n            Rascunho da página da biblioteca, já funcionando aqui. Por enquanto,\n            os elementos são de exemplo.\n          </p>\n        </div>\n        <BibliotecaWireframe class=\"revelar\" />\n      </section>\n\n      <footer class=\"rodape secao\">\n        <div class=\"chamada\">\n          <h2 class=\"chamada-texto\">Quer ver o trabalho para clientes?</h2>\n          <NuxtLink class=\"botao-ideia\" to=\"/\">Ver o portfólio</NuxtLink>\n        </div>\n        <div class=\"base-rodape\">\n          <span>© {{ new Date().getFullYear() }} Victor</span>\n          <div class=\"preferencias\">\n            <button @click=\"toggleTheme\" :aria-pressed=\"dark\">\n              {{ dark ? \"Tema claro\" : \"Tema escuro\" }}\n            </button>\n            <button @click=\"motion = !motion\" :aria-pressed=\"!motion\">\n              {{ motion ? \"Desligar movimento\" : \"Ligar movimento\" }}\n            </button>\n            <NuxtLink to=\"/#contato\">Contato</NuxtLink>\n          </div>\n        </div>\n      </footer>\n    </main>\n  </div>\n</template>\n"],"version":3}